                <TextView android:id="@+id/cell0_icon" style="@style/WidgetCellIcon" android:text="🌱"/>
                <TextView android:id="@+id/cell0_status" style="@style/WidgetCellStatus" android:text="—"/>
            </LinearLayout>
            <TextView android:id="@+id/cell0_name" style="@style/WidgetCellName" android:text="Habit"/>
            <ProgressBar android:id="@+id/cell0_bar" style="@style/WidgetCellBar"/>
        </LinearLayout>

