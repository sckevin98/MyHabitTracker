<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed only if you later switch to loading from github.io. Harmless otherwise. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MyHabits"
        android:supportsRtl="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Widget tap → open detail for habit X -->
            <intent-filter>
                <action android:name="com.myhabits.app.OPEN_HABIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HabitPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.MyHabits.Picker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 2×2 Single-habit widget -->
        <receiver
            android:name=".SingleHabitWidget"
            android:exported="true"
            android:label="@string/widget_single_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.myhabits.app.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_info" />
        </receiver>

        <!-- 4×2 / 4×4 Heatmap widget (one habit) -->
        <receiver
            android:name=".HeatmapWidget"
            android:exported="true"
            android:label="@string/widget_heatmap_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.myhabits.app.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_heatmap_info" />
        </receiver>

        <!-- 4×4 grid of all habits -->
        <receiver
            android:name=".AllHabitsWidget"
            android:exported="true"
            android:label="@string/widget_all_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.myhabits.app.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_all_habits_info" />
        </receiver>

        <!-- 4×2 top-streaks row -->
        <receiver
            android:name=".StreaksWidget"
            android:exported="true"
            android:label="@string/widget_streaks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.myhabits.app.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streaks_info" />
        </receiver>
    </application>
</manifest>
